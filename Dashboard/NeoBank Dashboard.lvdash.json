{
  "datasets": [
    {
      "name": "518de47a",
      "displayName": "Total Customer",
      "queryLines": [
        "SELECT COUNT(DISTINCT customer_id)AS total_customers FROM banking.gold.customer_360"
      ]
    },
    {
      "name": "a83c7724",
      "displayName": "Total deposits",
      "queryLines": [
        "SELECT SUM(total_balance) AS total_deposits FROM banking.gold.customer_360"
      ]
    },
    {
      "name": "1dc3d2a6",
      "displayName": "Total Transactions",
      "queryLines": [
        "SELECT COUNT(total_transactions)AS total_transactions FROM banking.gold.customer_360"
      ]
    },
    {
      "name": "260e0e42",
      "displayName": "High Risk Customers",
      "queryLines": [
        "SELECT COUNT(*) AS high_risk_customers FROM banking.gold.customer_360 WHERE risk_grade = 'HIGH';\r\n",
        "\r\n",
        " "
      ]
    },
    {
      "name": "9ca5cd33",
      "displayName": "Customer Segment",
      "queryLines": [
        "SELECT customer_segment,COUNT(*)AS customers FROM banking.gold.customer_360 GROUP BY customer_segment"
      ]
    },
    {
      "name": "885f55d4",
      "displayName": "Credit Risk Distribution",
      "queryLines": [
        "SELECT risk_grade ,COUNT(*) AS customers FROM banking.gold.customer_360 GROUP BY risk_grade"
      ]
    },
    {
      "name": "5e12b6d1",
      "displayName": "Top Customers",
      "queryLines": [
        "SELECT customer_name,branch_name ,total_balance FROM banking.gold.customer_360 ORDER BY total_balance DESC LIMIT 10"
      ]
    },
    {
      "name": "5bca8e94",
      "displayName": "Branch Deposits",
      "queryLines": [
        "SELECT branch_name,total_deposits FROM banking.gold.branch_performance ORDER BY total_deposits DESC"
      ]
    },
    {
      "name": "49690e85",
      "displayName": "Branch Customers",
      "queryLines": [
        "SELECT branch_name,total_customers FROM banking.gold.branch_performance ORDER BY total_customers DESC"
      ]
    },
    {
      "name": "5b75b50a",
      "displayName": "Branch Transactions",
      "queryLines": [
        "SELECT branch_name,total_transaction_amount FROM banking.gold.branch_performance ORDER BY total_transaction_amount DESC"
      ]
    },
    {
      "name": "624fe805",
      "displayName": "Gateway Transactions",
      "queryLines": [
        "SELECT gateway_name,SUM(successful_transactions) AS successful_transactions ,SUM(failed_transactions) AS failed_transactions FROM banking.gold.transaction_channel_summary GROUP BY gateway_name ORDER BY successful_transactions DESC,failed_transactions DESC;\r\n"
      ]
    },
    {
      "name": "df1e7f52",
      "displayName": "Device Transactions",
      "queryLines": [
        "SELECT device_type,SUM(total_transactions)AS total_transactions FROM banking.gold.transaction_channel_summary GROUP BY device_type ORDER BY total_transactions DESC"
      ]
    },
    {
      "name": "gateway_txns",
      "displayName": "Gateway Transaction Summary",
      "queryLines": [
        "SELECT\n",
        "  gateway_name,\n",
        "  'Successful' AS transaction_status,\n",
        "  SUM(successful_transactions) AS transaction_count\n",
        "FROM\n",
        "  banking.gold.transaction_channel_summary\n",
        "GROUP BY\n",
        "  gateway_name\n",
        "UNION ALL\n",
        "SELECT\n",
        "  gateway_name,\n",
        "  'Failed' AS transaction_status,\n",
        "  SUM(failed_transactions) AS transaction_count\n",
        "FROM\n",
        "  banking.gold.transaction_channel_summary\n",
        "GROUP BY\n",
        "  gateway_name"
      ]
    }
  ],
